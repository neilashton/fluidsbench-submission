{
  "schema_version": "1.0",
  "profile_definition_id": "airfrans-boundary-layer-v1",
  "dataset_id": "airfrans",
  "status": "owner_review_required",
  "source_library": {
    "name": "airfrans",
    "version": "0.1.5.1",
    "repository": "https://github.com/Extrality/airfrans_lib",
    "commit": "d35d4035d8ba6fa98c1a6662be925c2fc777610b",
    "source_file": "src/airfrans/simulation.py",
    "source_file_sha256": "77a74740ad482fa99adf8829ebdc4c4fe38b85de24d30d30a0c07806b1306c17",
    "routine": "airfrans.Simulation.boundary_layer"
  },
  "sampling_runtime": {
    "pyvista_version": "0.48.4",
    "vtk_version": "9.6.2",
    "status": "owner_review_required"
  },
  "extraction": {
    "source_array": "U",
    "surface": "extrados",
    "frame": "cartesian",
    "line_direction": "airfoil_surface_normal",
    "line_length_m": 0.1,
    "resolution_segments": 1000,
    "sample_count": 1001,
    "include_endpoints": true,
    "ground_truth_call_arguments": {
      "y": 0.1,
      "extrado": true,
      "direction": "normals",
      "local_frame": false,
      "resolution": 1000,
      "compressible": false,
      "reference": true
    },
    "prediction_call_arguments": {
      "y": 0.1,
      "extrado": true,
      "direction": "normals",
      "local_frame": false,
      "resolution": 1000,
      "compressible": false,
      "reference": false
    },
    "prediction_state_rule": "Replace Simulation.velocity with the submitted Cartesian U values on every native internal-mesh point. The helper's pressure and nut arrays are retained only because the pinned routine samples all arrays; their returned values are ignored and do not enter this metric.",
    "surface_origin_rule": "Use the pinned routine's nearest extrados airfoil point at the requested x_over_c and its stored airfoil normal.",
    "coordinate_rule": "Ignore the routine's returned yc value. Preserve sample_over_line order and publish wall-normal line arclength s = linspace(0.0, 0.1, 1001) in metres. This avoids treating the Cartesian y-coordinate difference as distance when the surface normal is inclined."
  },
  "coordinate": {
    "id": "wall_normal_arclength_m",
    "unit": "m",
    "interval": [
      0.0,
      0.1
    ],
    "spacing": "uniform",
    "sample_count": 1001
  },
  "stations": [
    {
      "id": "upper_x_0_25c",
      "x_over_c": 0.25
    },
    {
      "id": "upper_x_0_50c",
      "x_over_c": 0.5
    },
    {
      "id": "upper_x_0_75c",
      "x_over_c": 0.75
    },
    {
      "id": "upper_x_0_95c",
      "x_over_c": 0.95
    }
  ],
  "quantities": [
    {
      "id": "velocity_x_ratio",
      "routine_output_index": 1,
      "definition": "U_x / U_infinity"
    },
    {
      "id": "velocity_y_ratio",
      "routine_output_index": 2,
      "definition": "U_y / U_infinity"
    }
  ],
  "metric_binding": {
    "panel_id": "velocity_profiles",
    "metric_id": "velocity_profile_r2",
    "aggregation": "flatten_all_required_profile_samples",
    "case_coverage": "all_cases_in_selected_official_split",
    "series_coverage": "both_quantities_at_all_four_stations_for_every_case"
  },
  "prototype_fixture_policy": {
    "abridged_sample_count": 3,
    "coordinate_m": [
      0.0,
      0.05,
      0.1
    ],
    "scope": "repository_dummy_submissions_only",
    "note": "Abridged arrays exercise packaging and hash validation only. Approved submissions must use the 1001-point contract."
  }
}
