{
  "schema_version": "1.1",
  "dataset_id": "ahmedml",
  "dataset_name": "AhmedML",
  "dataset_version": "prototype-1",
  "status": "prototype_dummy_data",
  "evaluation_reference_version": "prototype-1",
  "default_field_reduction": "per_geometry_then_macro_average",
  "ranking": {
    "metric_id": "overall_score",
    "direction": "higher",
    "decimal_places": 1,
    "rounding": "decimal_half_up",
    "method": "competition"
  },
  "metrics": [
    {
      "id": "overall_score",
      "unit": "",
      "direction": "higher",
      "kind": "score",
      "equation": "0.50 S_field + 0.25 S_force + 0.25 S_profile",
      "aggregation": "derived_score_equation",
      "weighting": "equation_weights"
    },
    {
      "id": "field_score",
      "unit": "",
      "direction": "higher",
      "kind": "score",
      "equation": "2 sum_j w_j max(0, 100(1-e_j/c_j))",
      "aggregation": "derived_score_equation",
      "weighting": "equation_weights"
    },
    {
      "id": "force_score",
      "unit": "",
      "direction": "higher",
      "kind": "score",
      "equation": "(0.15 S_CD + 0.10 S_CL)/0.25",
      "aggregation": "derived_score_equation",
      "weighting": "equation_weights"
    },
    {
      "id": "diagnostic_score",
      "unit": "",
      "direction": "higher",
      "kind": "score",
      "equation": "(0.15 S_velocity + 0.10 S_Cp)/0.25",
      "aggregation": "derived_score_equation",
      "weighting": "equation_weights"
    },
    {
      "id": "surface_pressure_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i w_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i w_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "surface_face_area"
    },
    {
      "id": "surface_wall_shear_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i w_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i w_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "surface_face_area"
    },
    {
      "id": "volume_velocity_rel_l2",
      "unit": "%",
      "direction": "lower",
      "kind": "error",
      "equation": "100\\,\\frac{\\sqrt{\\sum_i w_i(\\hat{y}_i-y_i)^2}}{\\sqrt{\\sum_i w_i y_i^2}}",
      "aggregation": "per_geometry_then_macro_average",
      "weighting": "cell_volume"
    },
    {
